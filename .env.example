# Application runtime configuration (dotenv format, loaded by Next.js + typeORM).
# Copy to .env.local (gitignored) and fill in for local dev.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=rootpass
DB_NAME=edu_inst

# Next.js server
PORT=3000

# MySQL container bootstrap
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=edu_inst
MYSQL_PORT=3306
