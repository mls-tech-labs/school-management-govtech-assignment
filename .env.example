# Application runtime configuration (dotenv format, loaded by Next.js + typeORM).
# Copy to .env.local (gitignored) and fill in for local dev.

# ─── MySQL connection (Stage 1) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=rootpass
DB_NAME=edu_inst

# ─── Next.js server (Stage 1) ─────────────────────────────────────────────────
PORT=3000

# ─── MySQL container bootstrap (Stage 1) ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=edu_inst
MYSQL_PORT=3306

# ─── Auth feature (Stage 2 — 004-user-auth) ──────────────────────────────────
# Redis connection. REQUIRED — the application refuses to boot without it
# (fail-closed posture per spec FR-013). Format: redis://<host>:<port>.
# For local docker-compose this is `redis://redis:6379`; for local dev
# outside docker, point at the exposed port (default `redis://localhost:6379`).
REDIS_URL=redis://localhost:6379

# Cookie name carrying the opaque session token. Default `pvt_edu_session`.
SESSION_COOKIE_NAME=pvt_edu_session

# Whether the session cookie carries the `Secure` attribute. When unset,
# defaults to `true` only when NODE_ENV=production (per Principle IV).
# In local dev over HTTP set to `false` to keep the cookie usable.
SESSION_COOKIE_SECURE=

# Hard session TTL in seconds. Spec FR-015 pins the default at 1800
# (30 minutes). NO sliding extension. Lower it via env to exercise the
# TTL boundary in tests.
SESSION_TTL_SECONDS=1800

# Where the post-login browser lands when no `redirectTo` is present.
LOGIN_REDIRECT_DEFAULT=/

# Password hashing algorithm — only `argon2id` is supported. The constant
# exists so a future swap to a different algorithm is one env flip away.
PASSWORD_HASH_ALGO=argon2id

# ─── Security hardening (Stage 2 — 005-security-hardening) ───────────────────
# Comma-separated allow-list of origins permitted to call /api/* cross-origin.
# Empty (default) means: same-origin only; every cross-origin preflight is
# rejected with 403 (fail-closed per FR-013). Add your dev origin to use
# the API from a different host/port during local dev.
CORS_ALLOWED_ORIGINS=

# Comma-separated allowed request headers for CORS preflights.
# Defaults include the JSON Content-Type and the X-CSRF-Token header
# used by the double-submit CSRF control.
CORS_ALLOWED_HEADERS=Content-Type, X-CSRF-Token

# Content-Security-Policy value. The default ships as a strict
# policy EXCEPT for `script-src`, which includes `'unsafe-inline'`.
# This is a known and documented Next.js + strict-CSP trade-off:
# Next.js App Router does NOT attach a nonce or hash to its OWN
# inline scripts (RSC payload, hydration boot), so a strict
# `script-src 'self'` would block the page from rendering at all.
# Per-request nonces were attempted and abandoned (see commit
# history) for the same reason. The other directives — `style-src`,
# `frame-ancestors`, `object-src`, `form-action`, `base-uri`,
# `connect-src`, `img-src`, `font-src` — remain strict, which means
# clickjacking, `<object>`-based XSS, form-jacking, `<base href>`
# attacks, and unauthorized data exfiltration are still blocked.
# XSS via `script-src` is mitigated by React's built-in escaping
# (no `dangerouslySetInnerHTML` anywhere in the codebase) and by
# the `style-src`/`object-src`/`base-uri` strictness. Override
# only if you fully understand the trade-off.
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'

# When `true`, the CSP header is emitted as Content-Security-Policy-Report-Only
# (no enforcement, browser reports violations only). Default `false`.
CSP_REPORT_ONLY=false

# HSTS toggle. Default is `true` only when NODE_ENV=production. In dev over
# HTTP, HSTS is suppressed to avoid breaking the local browser.
HSTS_ENABLED=
